<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <section class="mb-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <h3 class="mb-4 text-lg font-semibold">Edit your post</h3>
        <form action="/update/<%= post._id %>" method="post" class="space-y-4">
          <textarea name="postText" id="" rows="4" placeholder="What's on your mind?" class="w-full resize-none rounded-xl border border-slate-300 p-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"> <%= post.postText %> </textarea>
          <input class="cursor-pointer rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700" value="Submit" type="submit">
        </form>
      </section>
  
</body>
</html>